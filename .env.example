# ============================================================
# CDSV UI — Environment Configuration
# Copy to .env (or .env.local for dev) — NEVER commit secrets
# ============================================================

# API base URL — override for production deployment
VITE_API_BASE_URL=/api/v1

# Application display name
VITE_APP_NAME=CDSV Telecom Forensic Platform

# Set to "false" to use real HTTP (backend must be reachable)
VITE_USE_MOCK_API=false

# --- SOC API resilience simulation (only when USE_MOCK_API=true) ---
VITE_SOC_API_FAILURE_RATE=0.05
VITE_SOC_API_MIN_LATENCY_MS=80
VITE_SOC_API_MAX_LATENCY_MS=420

# --- Feature flags ---
VITE_ENABLE_TELEMETRY=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# --- Build metadata (injected by CI/CD) ---
# VITE_BUILD_VERSION=1.0.0
# VITE_BUILD_COMMIT=abc1234
